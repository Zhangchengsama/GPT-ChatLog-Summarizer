{
  "manifest_version": 3,
  "name": "ChatGPT 聊天归档",
  "description": "将当前可见的 ChatGPT 对话增量归档为 Markdown、JSON 和 manifest。",
  "version": "0.2.0",
  "permissions": [
    "activeTab",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "action": {
    "default_title": "归档当前聊天",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
